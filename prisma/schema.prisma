generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum TripPhase {
  PLANNING
  OPEN
  SHOPPING
  CLOSED
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PURCHASED
  PAID
  DELIVERED
}

// ==========================================
// 1) USUARIOS / CLIENTES
// ==========================================

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique @db.VarChar(255)
  fullName      String?  @map("full_name") @db.VarChar(100)

  googleId      String?  @unique @map("google_id") @db.VarChar(255)

  role          String?  @default("CLIENT") @db.VarChar(20)
  isGlobalAdmin Boolean  @default(false) @map("is_global_admin")

  clients       Client[]

  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("users")
}

model Client {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(100)

  phone     String?  @db.VarChar(30)
  phoneNormalized String? @map("phone_normalized") @db.VarChar(30)

  userId    String?  @map("user_id") @db.Uuid
  user      User?    @relation(fields: [userId], references: [id])
  orders    Order[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([userId])
  @@index([phoneNormalized])
  @@map("clients")
}

// ==========================================
// 2) TIPO DE CAMBIO DIARIO (BANXICO)
// ==========================================

model ExchangeRate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date      DateTime @unique @db.Date
  rateMxn   Decimal  @map("rate_mxn") @db.Decimal(10,2)
  source    String?  @db.VarChar(30)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("exchange_rates")
}

// ==========================================
// 3) CATÁLOGOS (IDENTIDAD + NOMBRE EDITABLE)
// ==========================================

model ProductFeeCatalog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(100)
  enabled   Boolean  @default(true)

  tripFees  TripProductFee[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("product_fee_catalog")
}

model ExchangeRuleCatalog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(100)
  enabled   Boolean  @default(true)

  tripRules TripExchangeRule[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("exchange_rule_catalog")
}

// ✅ ProductType = categoría logística / tarifa base (según tu INSERT)
model ProductType {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(50)   // "KIDS_CLOTHING", ...
  name      String   @db.VarChar(100)          // "Ropa de Niños (70)"
  enabled   Boolean  @default(true)

  // relaciones
  variants          ProductVariant[]
  products          Product[]
  tripShippingRates TripShippingRate[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("product_types")
}

// ✅ NUEVO: Variantes visibles por tipo (ej: Playera/Pantalón para KIDS_CLOTHING)
model ProductVariant {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productTypeId String   @map("product_type_id") @db.Uuid

  code          String   @db.VarChar(50)   // "TSHIRT", "PANTS"
  name          String   @db.VarChar(120)  // "Playera", "Pantalón"
  enabled       Boolean  @default(true)

  productType   ProductType @relation(fields: [productTypeId], references: [id], onDelete: Cascade)
  products      Product[]

  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@unique([productTypeId, code])
  @@index([productTypeId])
  @@map("product_variants")
}

// ✅ NUEVO: Catálogo de marcas
model Brand {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(50) // "NIKE", "GUESS"
  name      String   @db.VarChar(100)        // "Nike", "Guess"
  enabled   Boolean  @default(true)

  products  Product[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("brands")
}

// ✅ NUEVO: Catálogo de colores
model Color {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(50) // "RED", "BLACK"
  name      String   @db.VarChar(100)        // "Rojo", "Negro"
  enabled   Boolean  @default(true)

  hex       String?  @db.VarChar(10)         // "#FF0000" opcional para UI

  products  Product[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("colors")
}

// Gastos operativos agrupados por tipo
model ExpenseCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(100)
  enabled   Boolean  @default(true)

  expenses  TripExpense[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("expense_categories")
}

// ==========================================
// 4) TRIPS + CONFIG
// ==========================================

model Trip {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String

  // status operativo (ACTIVE/INACTIVE)
  status    String    @default("ACTIVE") @db.VarChar(20)

  // fase logística
  phase     TripPhase @default(PLANNING)

  imagePath String?  @map("image_path")

  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date")   @db.Date

  exchangeRules TripExchangeRule[]
  productFees   TripProductFee[]
  shippingRates TripShippingRate[]
  tripProducts  TripProduct[]
  orders        Order[]
  expenses      TripExpense[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("trips")
}

// Valor por viaje: MXN por USD
model TripExchangeRule {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId       String  @map("trip_id") @db.Uuid
  catalogId    String  @map("catalog_id") @db.Uuid

  nameSnapshot String  @map("name_snapshot") @db.VarChar(100)
  valueAdded   Decimal @map("value_added") @db.Decimal(10,2)

  trip         Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  catalog      ExchangeRuleCatalog @relation(fields: [catalogId], references: [id])

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@unique([tripId, catalogId])
  @@index([tripId])
  @@map("trip_exchange_rules")
}

// Valor por viaje: % (fees)
model TripProductFee {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId         String  @map("trip_id") @db.Uuid
  catalogId      String  @map("catalog_id") @db.Uuid

  nameSnapshot   String  @map("name_snapshot") @db.VarChar(100)
  percentage     Decimal @db.Decimal(5,2)

  trip           Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  catalog        ProductFeeCatalog @relation(fields: [catalogId], references: [id])

  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@unique([tripId, catalogId])
  @@index([tripId])
  @@map("trip_product_fees")
}

// Envío fijo MXN por tipo (snapshot)
model TripShippingRate {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId        String  @map("trip_id") @db.Uuid
  productTypeId String  @map("product_type_id") @db.Uuid

  nameSnapshot  String  @map("name_snapshot") @db.VarChar(100)
  costMxn       Decimal @map("cost_mxn") @db.Decimal(12,2)
  enabled       Boolean @default(true)

  trip          Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  productType   ProductType @relation(fields: [productTypeId], references: [id])

  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@unique([tripId, productTypeId])
  @@index([tripId])
  @@map("trip_shipping_rates")
}

// Productos habilitados para el viaje (snapshot de precio USD por viaje)
model TripProduct {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId       String   @map("trip_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid

  isActive     Boolean  @default(true) @map("is_active")
  basePriceUsd Decimal? @map("base_price_usd") @db.Decimal(10,2)

  trip         Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id])

  orderItems   OrderItem[]

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@unique([tripId, productId])
  @@index([tripId])
  @@map("trip_products")
}

// ==========================================
// 5) PRODUCTO GLOBAL (ACTUALIZADO)
// ==========================================

// ==========================================
// IMÁGENES DE PRODUCTO (1 producto -> N imágenes)
// ==========================================
model ProductImage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String   @map("product_id") @db.Uuid

  // Guardamos el PATH en GCS (igual que antes hacías con imageUrl)
  path       String   @db.Text

  // Orden para mostrar galería (0,1,2...)
  sortOrder  Int      @default(0) @map("sort_order")

  // Marca "principal"
  isPrimary  Boolean  @default(false) @map("is_primary")

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([productId])
  @@index([productId, sortOrder])
  @@map("product_images")
}


// ==========================================
// PRODUCTO GLOBAL (sin imageUrl)
// ==========================================
model Product {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // name = detalle: "Logo Spiderman", "Con perlas", etc.
  name            String   @db.VarChar(255)

  defaultPriceUsd Decimal? @map("default_price_usd") @db.Decimal(10,2)
  defaultCategory String?  @map("default_category")

  isActive        Boolean  @default(true) @map("is_active")
  stock           Int      @default(0)

  // ✅ logística/tarifa
  productTypeId   String   @map("product_type_id") @db.Uuid
  productType     ProductType @relation(fields: [productTypeId], references: [id])

  // ✅ visible (Playera, Short, etc)
  productVariantId String  @map("product_variant_id") @db.Uuid
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])

  // ✅ catálogos
  brandId         String   @map("brand_id") @db.Uuid
  brand           Brand    @relation(fields: [brandId], references: [id])

  colorId         String   @map("color_id") @db.Uuid
  color           Color    @relation(fields: [colorId], references: [id])

  // ✅ NUEVO: galería de imágenes
  images          ProductImage[]

  tripProducts    TripProduct[]
  orderItems      OrderItem[]

  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([productTypeId])
  @@index([productVariantId])
  @@index([brandId])
  @@index([colorId])
  @@index([brandId, productTypeId, productVariantId, colorId])
  @@map("products")
}

// ==========================================
// 6) PEDIDOS + PAGOS + ITEMS
// ==========================================

model Order {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId          String      @map("trip_id") @db.Uuid
  clientId        String      @map("client_id") @db.Uuid
  status          OrderStatus @default(DRAFT)

  grandTotalMxn   Decimal     @default(0) @map("grand_total_mxn") @db.Decimal(14,2)
  paidTotalMxn    Decimal     @default(0) @map("paid_total_mxn") @db.Decimal(14,2)

  pricingLockedAt  DateTime? @map("pricing_locked_at") @db.Timestamp(6)
  exchangeRateDate DateTime? @map("exchange_rate_date") @db.Date
  exchangeRateBase Decimal?  @map("exchange_rate_base") @db.Decimal(10,2)
  exchangeRateAdd  Decimal   @default(0) @map("exchange_rate_add") @db.Decimal(10,2)

  trip            Trip       @relation(fields: [tripId], references: [id])
  client          Client     @relation(fields: [clientId], references: [id])

  items           OrderItem[]
  payments        OrderPayment[]
  appliedExchangeRules OrderExchangeRule[]

  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@unique([tripId, clientId])
  @@index([tripId, status])
  @@index([clientId])
  @@map("orders")
}

model OrderPayment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid

  amountMxn Decimal  @map("amount_mxn") @db.Decimal(14,2)
  method    String   @db.VarChar(20)
  reference String?  @db.VarChar(100)
  paidAt    DateTime @map("paid_at") @db.Timestamp(6)

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([orderId])
  @@map("order_payments")
}

model OrderExchangeRule {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String  @map("order_id") @db.Uuid
  tripExchangeRuleId String? @map("trip_exchange_rule_id") @db.Uuid

  nameSnapshot String  @map("name_snapshot") @db.VarChar(100)
  valueAdded   Decimal @map("value_added") @db.Decimal(10,2)

  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([orderId])
  @@map("order_exchange_rules")
}

model OrderItem {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String   @map("order_id") @db.Uuid

  tripProductId String?  @map("trip_product_id") @db.Uuid
  productId     String?  @map("product_id") @db.Uuid

  quantity      Int      @default(1)

  productName   String   @map("product_name") @db.VarChar(255)
  basePriceUsd  Decimal  @map("base_price_usd") @db.Decimal(10,2)

  productTypeId        String? @map("product_type_id") @db.Uuid
  productTypeSnapshot  String? @map("product_type_snapshot") @db.VarChar(100)

  shippingCostMxn Decimal @default(0) @map("shipping_cost_mxn") @db.Decimal(12,2)
  finalPriceMxn  Decimal @default(0) @map("final_price_mxn") @db.Decimal(14,2)

  appliedProductFees OrderItemProductFee[]

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product?     @relation(fields: [productId], references: [id])
  tripProduct TripProduct? @relation(fields: [tripProductId], references: [id])

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([orderId])
  @@index([tripProductId])
  @@map("order_items")
}

model OrderItemProductFee {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderItemId     String   @map("order_item_id") @db.Uuid
  tripProductFeeId String? @map("trip_product_fee_id") @db.Uuid

  nameSnapshot    String   @map("name_snapshot") @db.VarChar(100)
  percentageUsed  Decimal  @map("percentage_used") @db.Decimal(5,2)
  amountUsd       Decimal  @map("amount_usd") @db.Decimal(10,2)

  orderItem       OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([orderItemId])
  @@map("order_item_product_fees")
}

// ==========================================
// 7) GASTOS DEL VIAJE
// ==========================================

model TripExpense {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId      String   @map("trip_id") @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid

  currency    String   @default("MXN") @db.VarChar(3)
  amount      Decimal  @db.Decimal(14,2)

  exchangeRateBase Decimal? @map("exchange_rate_base") @db.Decimal(10,2)
  amountMxn        Decimal? @map("amount_mxn") @db.Decimal(14,2)

  expenseDate DateTime @map("expense_date") @db.Timestamp(6)
  note        String?  @db.VarChar(500)
  receiptUrl  String?  @map("receipt_url")

  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([tripId])
  @@map("trip_expenses")
}
